#!/usr/bin/env bash
# ==============================================================================
# Janus CLI: Unified Command Center for Hybrid Gaming & Dual-Boot Home Servers
# Repository: https://github.com/P1gBagPt-Homelab/janus-cli
# License: MIT
# ==============================================================================

set -eo pipefail

JANUS_VERSION="1.2.1"

# --- Color Definitions ---
BOLD="\033[1m"
DIM="\033[2m"
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
MAGENTA="\033[1;35m"
CYAN="\033[1;36m"
WHITE="\033[1;37m"
RESET="\033[0m"

# --- Configuration Loading ---
# Priority: ~/.janusrc > /etc/janus/janus.conf > Default Auto-Detection
if [[ -f "/etc/janus/janus.conf" ]]; then
    # shellcheck source=/dev/null
    source "/etc/janus/janus.conf"
fi
if [[ -f "${HOME}/.janusrc" ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/.janusrc"
fi

# Sensible Defaults
BACKUP_SCRIPT="${BACKUP_SCRIPT:-/data/scripts/backup-janus.sh}"
BACKUP_DIR="${BACKUP_DIR:-/data/backups/daily}"
RCLONE_REMOTE="${RCLONE_REMOTE:-janus-backup-encrypted:}"
WIREGUARD_CONTAINER="${WIREGUARD_CONTAINER:-}"
WIREGUARD_INTERFACE="${WIREGUARD_INTERFACE:-}"

# --- Helper: Auto-detect storage mounts ---
get_storage_paths() {
    if [[ -n "${STORAGE_PATHS:-}" ]]; then
        echo "$STORAGE_PATHS"
        return
    fi
    local paths="/"
    # Detect separate physical filesystems mounted under common paths
    for candidate in /data /home /mnt/* /media/*; do
        if [[ -d "$candidate" ]] && df -P "$candidate" >/dev/null 2>&1; then
            local mount_target
            mount_target=$(df -P "$candidate" 2>/dev/null | awk 'NR==2 {print $6}' || echo "")
            if [[ -n "$mount_target" && "$mount_target" != "/" ]] && [[ ! " ${paths} " =~ " ${mount_target} " ]]; then
                paths="${paths} ${mount_target}"
            fi
        fi
    done
    echo "$paths"
}

# --- Helper: Draw Visual Percentage Bar ---
draw_bar() {
    local pct="${1:-0}"
    local width="${2:-20}"
    
    if (( pct > 100 )); then pct=100; fi
    if (( pct < 0 )); then pct=0; fi

    local filled=$(( (pct * width) / 100 ))
    local empty=$(( width - filled ))
    
    local color="${GREEN}"
    if (( pct >= 85 )); then
        color="${RED}"
    elif (( pct >= 70 )); then
        color="${YELLOW}"
    fi

    printf "${color}["
    for ((i=0; i<filled; i++)); do printf "█"; done
    for ((i=0; i<empty; i++)); do printf "░"; done
    printf "] %3d%%${RESET}" "$pct"
}

# --- Helper: Dynamic Windows GRUB Entry Detection ---
get_windows_entry() {
    if [[ -n "${WINDOWS_GRUB_ENTRY:-}" ]]; then
        echo "$WINDOWS_GRUB_ENTRY"
        return
    fi

    # Attempt to auto-detect from GRUB config
    if [[ -f /boot/grub/grub.cfg ]]; then
        local detected
        detected=$(grep -E "menuentry '.*Windows Boot Manager" /boot/grub/grub.cfg 2>/dev/null | head -n1 | cut -d"'" -f2 || true)
        if [[ -n "$detected" ]]; then
            echo "$detected"
            return
        fi
    fi

    # Return empty if no Windows entry detected
    echo ""
}

# --- Helper: Inspect automated backups ---
get_backup_info() {
    local today
    today=$(date +"%Y-%m-%d")

    BACKUP_EXISTS=false
    BACKUP_TODAY_DONE=false
    BACKUP_TODAY_FILE=""
    BACKUP_TODAY_SIZE=""
    BACKUP_TODAY_TIME=""
    BACKUP_TOTAL_COUNT=0
    BACKUP_TOTAL_SIZE="0B"
    BACKUP_LATEST_FILE=""
    BACKUP_LATEST_DATE=""
    BACKUP_FILES=()

    if [[ ! -d "$BACKUP_DIR" ]]; then
        return
    fi

    BACKUP_EXISTS=true
    BACKUP_TOTAL_SIZE=$(du -sh "$BACKUP_DIR" 2>/dev/null | awk '{print $1}' || echo "0B")

    # Find backup archives sorted newest to oldest
    local raw_files=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && raw_files+=("$f")
    done < <(find "$BACKUP_DIR" -maxdepth 1 -type f \( -name "janus_backup_*.tar.gz" -o -name "*.tar.gz" -o -name "*.tgz" \) 2>/dev/null | sort -r || true)

    BACKUP_TOTAL_COUNT=${#raw_files[@]}
    BACKUP_FILES=("${raw_files[@]}")

    if (( BACKUP_TOTAL_COUNT > 0 )); then
        local first_file="${raw_files[0]}"
        BACKUP_LATEST_FILE=$(basename "$first_file")

        # Check files for today's backup
        for f in "${raw_files[@]}"; do
            local fname
            fname=$(basename "$f")

            # Check if filename contains today's date YYYY-MM-DD
            local is_today=false
            if [[ "$fname" =~ ([0-9]{4}-[0-9]{2}-[0-9]{2}) ]]; then
                if [[ "${BASH_REMATCH[1]}" == "$today" ]]; then
                    is_today=true
                fi
            else
                # Fallback to file modification date only if no date is in the filename
                local fdate=""
                if date -r "$f" +"%Y-%m-%d" >/dev/null 2>&1; then
                    fdate=$(date -r "$f" +"%Y-%m-%d")
                elif stat -c '%y' "$f" >/dev/null 2>&1; then
                    fdate=$(stat -c '%y' "$f" | cut -d' ' -f1)
                fi
                if [[ "$fdate" == "$today" ]]; then
                    is_today=true
                fi
            fi

            if [[ "$is_today" == "true" && "$BACKUP_TODAY_DONE" == "false" ]]; then
                BACKUP_TODAY_DONE=true
                BACKUP_TODAY_FILE="$fname"
                BACKUP_TODAY_SIZE=$(ls -lh "$f" 2>/dev/null | awk '{print $5}' || echo "unknown")
                if date -r "$f" +"%H:%M:%S" >/dev/null 2>&1; then
                    BACKUP_TODAY_TIME=$(date -r "$f" +"%H:%M:%S")
                elif stat -c '%y' "$f" >/dev/null 2>&1; then
                    BACKUP_TODAY_TIME=$(stat -c '%y' "$f" | awk '{print $2}' | cut -d. -f1)
                else
                    BACKUP_TODAY_TIME="03:00"
                fi
            fi
        done
    fi
}

# --- Helper: Inspect WireGuard status (Host & Docker / wg-easy) ---
get_wireguard_info() {
    WG_ACTIVE=false
    WG_IP="Not active"
    WG_PEERS_COUNT=0
    WG_SOURCE=""
    WG_CONTAINER=""
    WG_STATUS_MSG="Not running"

    # 1. Check host WireGuard
    local host_iface="${WIREGUARD_INTERFACE:-}"
    if command -v wg >/dev/null 2>&1; then
        local wg_out=""
        if [[ $EUID -eq 0 ]]; then
            wg_out=$(wg show 2>/dev/null || true)
        else
            wg_out=$(sudo -n wg show 2>/dev/null || sudo wg show 2>/dev/null || true)
        fi

        if [[ -n "$wg_out" ]]; then
            WG_ACTIVE=true
            WG_SOURCE="host"
            if [[ -z "$host_iface" ]]; then
                if [[ $EUID -eq 0 ]]; then
                    host_iface=$(wg show interfaces 2>/dev/null | awk '{print $1}')
                else
                    host_iface=$(sudo -n wg show interfaces 2>/dev/null || sudo wg show interfaces 2>/dev/null || true)
                    host_iface=$(echo "$host_iface" | awk '{print $1}')
                fi
            fi
            
            # Count registered peer keys
            local count
            count=$(echo "$wg_out" | grep -c '^[ \t]*peer:' || echo "0")
            WG_PEERS_COUNT=$((count + 0))
        fi
    fi

    # Fallback to ip link on host if wg binary was not available or had no output
    if [[ "$WG_ACTIVE" != "true" && -z "$host_iface" ]]; then
        if command -v ip >/dev/null 2>&1; then
            host_iface=$(ip -o link show 2>/dev/null | grep -E '^[0-9]+: *wg[0-9a-zA-Z_-]*:' | awk -F': ' '{print $2}' | head -n1 || true)
        fi
    fi

    if [[ -n "$host_iface" ]]; then
        local host_ip=""
        if command -v ip >/dev/null 2>&1; then
            host_ip=$(ip -4 addr show "$host_iface" 2>/dev/null | grep -w inet | awk '{print $2}' | cut -d/ -f1 | head -n1 || true)
        fi
        if [[ -n "$host_ip" ]]; then
            WG_ACTIVE=true
            WG_SOURCE="host"
            WG_IP="$host_ip"
        fi
    fi

    if [[ "$WG_ACTIVE" == "true" && "$WG_SOURCE" == "host" ]]; then
        local s=""
        [[ "$WG_PEERS_COUNT" -ne 1 ]] && s="s"
        WG_STATUS_MSG="Active (${WG_PEERS_COUNT} registered client key${s})"
        return
    fi

    # 2. Check Docker for wg-easy or WireGuard containers
    if command -v docker >/dev/null 2>&1; then
        local docker_cmd="docker"
        if ! docker ps >/dev/null 2>&1; then
            if sudo -n docker ps >/dev/null 2>&1; then
                docker_cmd="sudo -n docker"
            fi
        fi

        local wg_c="${WIREGUARD_CONTAINER:-}"
        if [[ -z "$wg_c" ]]; then
            # Search running containers for wg-easy or wireguard
            wg_c=$($docker_cmd ps --format '{{.Names}}' 2>/dev/null | grep -E '^wg-easy$' | head -n1 || true)
            if [[ -z "$wg_c" ]]; then
                wg_c=$($docker_cmd ps --format '{{.Names}}' 2>/dev/null | grep -Ei 'wg-easy|wireguard' | head -n1 || true)
            fi
        else
            # Verify specified container is running
            if ! $docker_cmd ps --format '{{.Names}}' 2>/dev/null | grep -q "^${wg_c}$"; then
                wg_c=""
            fi
        fi

        if [[ -n "$wg_c" ]]; then
            WG_CONTAINER="$wg_c"
            
            # Inspect WireGuard inside container
            local c_wg_out=""
            c_wg_out=$($docker_cmd exec "$wg_c" wg show 2>/dev/null | tr -d '\r' || true)

            # Discover interface inside container (usually wg0)
            local c_iface=""
            c_iface=$($docker_cmd exec "$wg_c" wg show interfaces 2>/dev/null | tr -d '\r' | awk '{print $1}' || true)
            [[ -z "$c_iface" ]] && c_iface="wg0"

            # Get IP inside container
            local c_ip=""
            c_ip=$($docker_cmd exec "$wg_c" ip -4 addr show "$c_iface" 2>/dev/null | tr -d '\r' | grep -w inet | awk '{print $2}' | cut -d/ -f1 | head -n1 || true)
            if [[ -z "$c_ip" ]]; then
                c_ip=$($docker_cmd exec "$wg_c" grep -i '^[ \t]*Address' "/etc/wireguard/${c_iface}.conf" 2>/dev/null | tr -d '\r' | awk -F'=' '{print $2}' | cut -d/ -f1 | tr -d ' ' | head -n1 || true)
            fi

            # Count registered peers
            local c_peers=0
            if [[ -n "$c_wg_out" ]]; then
                c_peers=$(echo "$c_wg_out" | grep -c '^[ \t]*peer:' || echo "0")
            fi
            if (( c_peers == 0 )); then
                local conf_peers
                conf_peers=$($docker_cmd exec "$wg_c" grep -c '^[ \t]*\[Peer\]' "/etc/wireguard/${c_iface}.conf" 2>/dev/null | tr -d '\r' || echo "0")
                if (( conf_peers > 0 )); then
                    c_peers=$conf_peers
                fi
            fi

            WG_ACTIVE=true
            WG_SOURCE="docker"
            WG_PEERS_COUNT=$((c_peers + 0))
            [[ -n "$c_ip" ]] && WG_IP="$c_ip"

            local s=""
            [[ "$WG_PEERS_COUNT" -ne 1 ]] && s="s"
            WG_STATUS_MSG="Active (${WG_PEERS_COUNT} registered client key${s} • Docker: ${WG_CONTAINER})"
            return
        fi
    fi

    # 3. Status message when inactive
    if command -v wg >/dev/null 2>&1 && [[ $EUID -ne 0 ]]; then
        WG_STATUS_MSG="Not running or requires sudo for wg status"
    else
        WG_STATUS_MSG="Not running"
    fi
}

# --- ASCII Banner ---
banner() {
    echo -e "${CYAN}${BOLD}"
    cat << "EOF"
      ██╗ █████╗ ███╗   ██╗██╗   ██╗███████╗
      ██║██╔══██╗████╗  ██║██║   ██║██╔════╝
      ██║███████║██╔██╗ ██║██║   ██║███████╗
 ██   ██║██╔══██║██║╚██╗██║██║   ██║╚════██║
 ╚█████╔╝██║  ██║██║ ╚████║╚██████╔╝███████║
  ╚════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝ ╚══════╝
EOF
    echo -e "${RESET}${DIM}   Janus CLI v${JANUS_VERSION} • Hybrid Gaming & Home Server Manager${RESET}\n"
}

# ==============================================================================
# SUBCOMMAND: status
# ==============================================================================
cmd_status() {
    banner

    # WireGuard Telemetry
    get_wireguard_info

    # 1. System Overview
    local hostname
    hostname=$(hostname)
    local uptime_str
    uptime_str=$(uptime -p 2>/dev/null || uptime | awk -F'( |,|:)+' '{print $6,"hrs",$7,"min"}')
    local kernel
    kernel=$(uname -r)
    local ip_lan="Unknown"
    if command -v ip >/dev/null 2>&1; then
        ip_lan=$(ip -4 addr show scope global 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -n1 || echo "Unknown")
    fi
    local ip_wg="${WG_IP}"

    echo -e "${WHITE}${BOLD}🖥️  SYSTEM OVERVIEW${RESET}"
    echo -e "  ${DIM}Host:${RESET}     ${BOLD}${hostname}${RESET}  |  ${DIM}Uptime:${RESET} ${uptime_str}"
    echo -e "  ${DIM}Kernel:${RESET}   ${kernel}"
    echo -e "  ${DIM}LAN IP:${RESET}   ${GREEN}${ip_lan}${RESET}  |  ${DIM}WireGuard IP:${RESET} ${CYAN}${ip_wg}${RESET}"
    echo ""

    # 2. CPU & Thermals
    local cpu_model
    cpu_model=$(grep -m1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}' | sed 's/^[ \t]*//' || echo "Unknown CPU")
    local cpu_cores
    cpu_cores=$(nproc)
    local load_avg
    load_avg=$(awk '{print $1", "$2", "$3}' /proc/loadavg)
    
    local cpu_temp="N/A"
    if command -v sensors >/dev/null 2>&1; then
        cpu_temp=$(sensors 2>/dev/null | grep -E "Package id 0|Tctl|CPU Temperature" | head -n1 | awk '{print $4}' | tr -d '+' || echo "N/A")
    fi
    if [[ "$cpu_temp" == "N/A" ]] && [[ -f /sys/class/thermal/thermal_zone0/temp ]]; then
        cpu_temp="$(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))°C"
    fi

    echo -e "${WHITE}${BOLD}⚡ CPU & LOAD${RESET}"
    echo -e "  ${DIM}Model:${RESET}    ${cpu_model} (${cpu_cores} Cores)"
    echo -e "  ${DIM}Load Avg:${RESET} [1m, 5m, 15m] -> ${BOLD}${load_avg}${RESET}  |  ${DIM}Temp:${RESET} ${YELLOW}${cpu_temp}${RESET}"
    echo ""

    # 3. RAM Utilization
    local ram_total
    ram_total=$(free -m | awk '/Mem:/ {print $2}')
    local ram_used
    ram_used=$(free -m | awk '/Mem:/ {print $3}')
    local ram_pct=$(( (ram_used * 100) / ram_total ))
    local ram_bar
    ram_bar=$(draw_bar "$ram_pct" 22)
    local ram_used_gb
    ram_used_gb=$(awk "BEGIN {printf \"%.1f\", ${ram_used}/1024}")
    local ram_total_gb
    ram_total_gb=$(awk "BEGIN {printf \"%.1f\", ${ram_total}/1024}")

    echo -e "${WHITE}${BOLD}🧠 MEMORY (RAM)${RESET}"
    echo -e "  ${ram_bar}  ${BOLD}${ram_used_gb} GB${RESET} / ${ram_total_gb} GB"
    echo ""

    # 4. Storage Pools (Dynamic Discovery)
    echo -e "${WHITE}${BOLD}💾 STORAGE POOLS${RESET}"
    local active_paths
    active_paths=$(get_storage_paths)
    for mount_pt in ${active_paths}; do
        if df -h "$mount_pt" >/dev/null 2>&1; then
            local total used pct bar
            total=$(df -h "$mount_pt" | awk 'NR==2 {print $2}')
            used=$(df -h "$mount_pt" | awk 'NR==2 {print $3}')
            pct=$(df -h "$mount_pt" | awk 'NR==2 {print $5}' | tr -d '%')
            bar=$(draw_bar "$pct" 18)
            printf "  ${DIM}%-18s${RESET} %s  ${BOLD}%s${RESET} / %s\n" "Mount ($mount_pt):" "$bar" "$used" "$total"
        fi
    done
    echo ""

    # 5. NVIDIA GPU Telemetry
    if command -v nvidia-smi >/dev/null 2>&1; then
        echo -e "${WHITE}${BOLD}🎮 NVIDIA GPU ACCELERATION${RESET}"
        local gpu_info
        gpu_info=$(nvidia-smi --query-gpu=name,driver_version,temperature.gpu,fan.speed,memory.used,memory.total,power.draw,power.limit --format=csv,noheader,nounits 2>/dev/null || echo "")
        if [[ -n "$gpu_info" ]]; then
            IFS=',' read -r gpu_name driver_ver gpu_temp fan_spd mem_used mem_total pwr_draw pwr_limit <<< "$gpu_info"
            
            gpu_name=$(echo "$gpu_name" | xargs)
            driver_ver=$(echo "$driver_ver" | xargs)
            gpu_temp=$(echo "$gpu_temp" | xargs)
            fan_spd=$(echo "$fan_spd" | xargs)
            mem_used=$(echo "$mem_used" | xargs)
            mem_total=$(echo "$mem_total" | xargs)
            pwr_draw=$(echo "$pwr_draw" | xargs)
            pwr_limit=$(echo "$pwr_limit" | xargs)

            local vram_pct=$(( (mem_used * 100) / mem_total ))
            local vram_bar
            vram_bar=$(draw_bar "$vram_pct" 18)
            local mem_used_gb
            mem_used_gb=$(awk "BEGIN {printf \"%.2f\", ${mem_used}/1024}")
            local mem_total_gb
            mem_total_gb=$(awk "BEGIN {printf \"%.1f\", ${mem_total}/1024}")

            echo -e "  ${DIM}Model:${RESET}    ${BOLD}${gpu_name}${RESET} (Driver: ${driver_ver})"
            echo -e "  ${DIM}Temp / Fan:${RESET} ${YELLOW}${gpu_temp}°C${RESET}  |  Fan: ${fan_spd}%  |  Power: ${BOLD}${pwr_draw}W${RESET} / ${pwr_limit}W"
            echo -e "  ${DIM}VRAM:${RESET}     ${vram_bar}  ${BOLD}${mem_used_gb} GB${RESET} / ${mem_total_gb} GB"
            
            # Show active GPU compute processes (e.g. Ollama, Jellyfin)
            local gpu_procs
            gpu_procs=$(nvidia-smi --query-compute-apps=process_name,used_memory --format=csv,noheader,nounits 2>/dev/null || true)
            if [[ -n "$gpu_procs" ]]; then
                echo -e "  ${DIM}Active Compute Processes:${RESET}"
                while IFS=',' read -r proc_name proc_mem; do
                    proc_name=$(echo "$proc_name" | xargs | awk -F/ '{print $NF}')
                    proc_mem=$(echo "$proc_mem" | xargs)
                    echo -e "    • ${GREEN}${proc_name}${RESET}: ${proc_mem} MiB VRAM"
                done <<< "$gpu_procs"
            else
                echo -e "  ${DIM}Active Compute Processes:${RESET} None (GPU Idle / Low Power State)"
            fi
        else
            echo -e "  ${RED}NVIDIA Driver loaded but no GPU query response.${RESET}"
        fi
        echo ""
    fi

    # 6. Docker & Homelab Containers (Dynamic Auto-Discovery)
    if command -v docker >/dev/null 2>&1; then
        echo -e "${WHITE}${BOLD}🐳 DOCKER & HOMELAB CONTAINERS${RESET}"
        local running_cnt total_cnt
        running_cnt=$(docker ps -q 2>/dev/null | wc -l || echo "0")
        total_cnt=$(docker ps -aq 2>/dev/null | wc -l || echo "0")
        echo -e "  ${DIM}Overview:${RESET} ${GREEN}${running_cnt} Running${RESET} / ${total_cnt} Total"

        if [[ -n "${WATCHED_CONTAINERS:-}" ]]; then
            # Pinned custom list of watched containers from janus.conf
            printf "  "
            local col=0
            for svc in ${WATCHED_CONTAINERS}; do
                if docker ps --format '{{.Names}}' 2>/dev/null | grep -qi "$svc"; then
                    printf "${GREEN}● %-18s${RESET} " "$svc"
                else
                    printf "${DIM}○ %-18s${RESET} " "$svc"
                fi
                col=$((col + 1))
                if (( col % 4 == 0 )); then
                    printf "\n  "
                fi
            done
            if (( col % 4 != 0 )); then printf "\n"; fi
        else
            # 100% Dynamic Discovery: display actual running containers
            local running_containers=()
            while IFS= read -r line; do
                [[ -n "$line" ]] && running_containers+=("$line")
            done < <(docker ps --format '{{.Names}}' 2>/dev/null | sort || true)

            if (( ${#running_containers[@]} > 0 )); then
                printf "  "
                local col=0
                for c_name in "${running_containers[@]}"; do
                    local display_name="$c_name"
                    if (( ${#display_name} > 20 )); then
                        display_name="${display_name:0:17}..."
                    fi
                    printf "${GREEN}● %-20s${RESET} " "$display_name"
                    col=$((col + 1))
                    if (( col % 3 == 0 )); then
                        printf "\n  "
                    fi
                done
                if (( col % 3 != 0 )); then printf "\n"; fi
            else
                echo -e "  ${DIM}No active containers currently running.${RESET}"
            fi

            # List stopped / exited containers if any exist
            local stopped_containers=()
            while IFS= read -r line; do
                [[ -n "$line" ]] && stopped_containers+=("$line")
            done < <(docker ps -a --filter "status=exited" --filter "status=dead" --format '{{.Names}}' 2>/dev/null | sort || true)

            if (( ${#stopped_containers[@]} > 0 )); then
                echo -e "  ${DIM}Stopped / Exited (${#stopped_containers[@]}):${RESET}"
                printf "  "
                local col=0
                for c_name in "${stopped_containers[@]}"; do
                    local display_name="$c_name"
                    if (( ${#display_name} > 20 )); then
                        display_name="${display_name:0:17}..."
                    fi
                    printf "${DIM}○ %-20s${RESET} " "$display_name"
                    col=$((col + 1))
                    if (( col % 3 == 0 )); then
                        printf "\n  "
                    fi
                done
                if (( col % 3 != 0 )); then printf "\n"; fi
            fi
        fi
        echo ""
    fi

    # 7. WireGuard & Firewall Status
    echo -e "${WHITE}${BOLD}🛡️  NETWORK PERIMETER & FIREWALL${RESET}"
    if [[ "$WG_ACTIVE" == "true" ]]; then
        echo -e "  ${DIM}WireGuard:${RESET} ${GREEN}${WG_STATUS_MSG}${RESET}"
    else
        echo -e "  ${DIM}WireGuard:${RESET} ${YELLOW}${WG_STATUS_MSG}${RESET}"
    fi

    if command -v ufw >/dev/null 2>&1; then
        local ufw_status
        ufw_status=$(sudo -n ufw status 2>/dev/null || sudo ufw status 2>/dev/null || true)
        ufw_status=$(echo "$ufw_status" | grep "Status:" | awk '{print $2}' || echo "unknown")
        if [[ "$ufw_status" == "active" ]]; then
            echo -e "  ${DIM}UFW:${RESET}       ${GREEN}Active (Default Deny Incoming)${RESET}"
        else
            echo -e "  ${DIM}UFW:${RESET}       ${RED}${ufw_status}${RESET}"
        fi
    fi
    echo ""

    # 8. Automated Backups Status
    echo -e "${WHITE}${BOLD}📦 AUTOMATED BACKUPS${RESET}"
    get_backup_info
    if [[ "$BACKUP_EXISTS" != "true" ]]; then
        echo -e "  ${DIM}Repository:${RESET}    ${YELLOW}Directory ${BACKUP_DIR} not found${RESET}"
    else
        if [[ "$BACKUP_TODAY_DONE" == "true" ]]; then
            echo -e "  ${DIM}Today's Backup:${RESET} ${GREEN}${BOLD}✓ COMPLETED${RESET} (${BACKUP_TODAY_TIME} • ${BACKUP_TODAY_SIZE} • ${BACKUP_TODAY_FILE})"
        else
            echo -e "  ${DIM}Today's Backup:${RESET} ${YELLOW}${BOLD}⚠ NOT DONE YET${RESET} (Scheduled / Pending)"
        fi
        echo -e "  ${DIM}Local Storage:${RESET}  ${BOLD}${BACKUP_TOTAL_COUNT} snapshots${RESET} (${BACKUP_TOTAL_SIZE}) in ${BACKUP_DIR}"
        if [[ -n "$BACKUP_LATEST_FILE" && "$BACKUP_TODAY_DONE" != "true" ]]; then
            echo -e "  ${DIM}Latest Backup:${RESET}  ${BACKUP_LATEST_FILE}"
        fi
        echo -e "  ${DIM}Cloud Remote:${RESET}   ${RCLONE_REMOTE}"
    fi
    echo ""
}

# ==============================================================================
# SUBCOMMAND: to-windows
# ==============================================================================
cmd_to_windows() {
    banner
    echo -e "${YELLOW}${BOLD}⚠️  DUAL-BOOT SWITCH: SWITCHING TO WINDOWS GAMING MODE${RESET}\n"

    local win_entry
    win_entry=$(get_windows_entry)

    if [[ -z "$win_entry" ]]; then
        echo -e "${RED}Error: No 'Windows Boot Manager' entry detected in /boot/grub/grub.cfg.${RESET}"
        echo -e "If this server is configured for dual-booting, you can explicitly define your GRUB entry in /etc/janus/janus.conf:"
        echo -e "  WINDOWS_GRUB_ENTRY=\"Windows Boot Manager (on /dev/nvme0n1p1)\"\n"
        return 1
    fi

    echo -e "Target GRUB Entry: ${BOLD}${CYAN}${win_entry}${RESET}"
    echo -e "This will set a ${CYAN}one-time next boot${RESET} to Windows Gaming Rig via ${BOLD}grub-reboot${RESET}."
    echo -e "After gaming, simply rebooting or shutting down Windows will automatically return to ${GREEN}Ubuntu Server${RESET}."
    echo ""
    read -p "Are you sure you want to reboot into Windows now? (y/N): " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "\n${CYAN}Configuring GRUB next-boot target...${RESET}"
        sudo grub-reboot "$win_entry"
        echo -e "${GREEN}✓ Next boot set to: ${win_entry}${RESET}"
        echo -e "${YELLOW}Initiating graceful server reboot in 3 seconds... (Press Ctrl+C to abort)${RESET}"
        sleep 3
        sudo reboot
    else
        echo -e "\n${WHITE}Action cancelled. Machine remains on Linux.${RESET}"
    fi
}

# ==============================================================================
# SUBCOMMAND: backup
# ==============================================================================
cmd_backup() {
    local action="${1:-}"

    if [[ "$action" == "--status" || "$action" == "-s" || "$action" == "status" || "$action" == "list" || "$action" == "-l" || "$action" == "--list" || -z "$action" ]]; then
        banner
        local today
        today=$(date +"%Y-%m-%d")
        get_backup_info

        echo -e "${WHITE}${BOLD}📦 AUTOMATED BACKUP INVENTORY & STATUS${RESET}\n"

        # 1. Today's Backup Status
        echo -e "${WHITE}${BOLD}📅 Today's Backup Status (${today}):${RESET}"
        if [[ "$BACKUP_TODAY_DONE" == "true" ]]; then
            echo -e "  ${GREEN}${BOLD}✓ COMPLETED${RESET} — Today's backup has been successfully created and archived!"
            echo -e "  ${DIM}Archive:${RESET}   ${BOLD}${BACKUP_TODAY_FILE}${RESET}"
            echo -e "  ${DIM}Size:${RESET}      ${GREEN}${BACKUP_TODAY_SIZE}${RESET}"
            echo -e "  ${DIM}Created:${RESET}   Today at ${BACKUP_TODAY_TIME}"
        else
            echo -e "  ${YELLOW}${BOLD}⚠ NOT DONE YET${RESET} — No backup snapshot has been created yet today."
            echo -e "  ${DIM}Schedule:${RESET} Runs automatically on server boot and hourly check via cron."
            echo -e "  ${DIM}Action:${RESET}   Run ${CYAN}${BOLD}janus backup run${RESET} or ${CYAN}janus backup --force${RESET} to trigger now."
        fi
        echo ""

        # 2. Local Backup Repository Overview
        echo -e "${WHITE}${BOLD}💾 Local Snapshot Inventory (${BACKUP_DIR}/):${RESET}"
        if [[ "$BACKUP_EXISTS" != "true" ]]; then
            echo -e "  ${YELLOW}Directory ${BACKUP_DIR} does not exist yet.${RESET}"
        elif (( BACKUP_TOTAL_COUNT == 0 )); then
            echo -e "  ${YELLOW}No backup archives found in ${BACKUP_DIR}.${RESET}"
        else
            echo -e "  ${DIM}Total:${RESET} ${BOLD}${BACKUP_TOTAL_COUNT} snapshots${RESET} (${BOLD}${BACKUP_TOTAL_SIZE}${RESET})  |  Retention: 14 days local, 60 days cloud"
            echo ""
            printf "  ${DIM}%-12s %-8s %-10s %-42s %s${RESET}\n" "DATE" "TIME" "SIZE" "SNAPSHOT ARCHIVE" "STATUS"
            printf "  ${DIM}%-12s %-8s %-10s %-42s %s${RESET}\n" "------------" "--------" "----------" "------------------------------------------" "----------------"

            for f in "${BACKUP_FILES[@]}"; do
                local fname
                fname=$(basename "$f")
                local fsize
                fsize=$(ls -lh "$f" 2>/dev/null | awk '{print $5}' || echo "-")
                local fdate="Unknown"
                local ftime="--"
                if date -r "$f" +"%Y-%m-%d" >/dev/null 2>&1; then
                    fdate=$(date -r "$f" +"%Y-%m-%d")
                    ftime=$(date -r "$f" +"%H:%M")
                elif stat -c '%y' "$f" >/dev/null 2>&1; then
                    fdate=$(stat -c '%y' "$f" | cut -d' ' -f1)
                    ftime=$(stat -c '%y' "$f" | awk '{print $2}' | cut -d: -f1,2)
                fi

                if [[ "$fname" =~ ([0-9]{4}-[0-9]{2}-[0-9]{2}) ]]; then
                    fdate="${BASH_REMATCH[1]}"
                fi

                local status_tag=""
                if [[ "$fname" == *"$today"* || "$fdate" == "$today" ]]; then
                    status_tag="${GREEN}${BOLD}[TODAY]${RESET}"
                else
                    status_tag="${DIM}Archived${RESET}"
                fi

                local display_name="$fname"
                if (( ${#display_name} > 40 )); then
                    display_name="${display_name:0:37}..."
                fi

                printf "  %-12s %-8s %-10s %-42s %b\n" "$fdate" "$ftime" "$fsize" "$display_name" "$status_tag"
            done
        fi
        echo ""

        # 3. Cloud Remote Storage (Rclone)
        if command -v rclone >/dev/null 2>&1; then
            echo -e "${WHITE}${BOLD}☁️  Cloud Remote Storage (${RCLONE_REMOTE}):${RESET}"
            rclone about "$RCLONE_REMOTE" 2>/dev/null || echo -e "  ${DIM}Remote configured (${RCLONE_REMOTE}), but unreachable or offline.${RESET}"
            echo ""
        fi
        return
    fi

    # Trigger manual execution
    banner

    if [[ ! -f "$BACKUP_SCRIPT" ]]; then
        echo -e "${RED}Error: Backup script not found at ${BACKUP_SCRIPT}${RESET}"
        echo -e "Configure BACKUP_SCRIPT in /etc/janus/janus.conf or create the script."
        exit 1
    fi

    # Check if backup for today was already created
    get_backup_info
    local is_forced=false
    for arg in "$@"; do
        if [[ "$arg" == "--force" || "$arg" == "-f" ]]; then
            is_forced=true
            break
        fi
    done

    if [[ "$BACKUP_TODAY_DONE" == "true" && "$is_forced" == "false" ]]; then
        echo -e "${GREEN}${BOLD}✓ Today's backup already exists:${RESET} ${BACKUP_TODAY_FILE} (${BACKUP_TODAY_SIZE})"
        echo -e "${YELLOW}To force another backup snapshot today, pass --force:${RESET}"
        echo -e "  ${CYAN}janus backup run --force${RESET}\n"
        read -p "Do you want to proceed with a forced backup now? (y/N): " confirm_backup
        if [[ ! "$confirm_backup" =~ ^[Yy]$ ]]; then
            echo -e "\n${WHITE}Backup cancelled. Machine remains protected by existing snapshot.${RESET}"
            return 0
        fi
        set -- "$@" "--force"
    fi

    echo -e "${CYAN}${BOLD}🚀 TRIGGERING AUTOMATED BACKUP${RESET}"
    echo -e "${DIM}Script: ${BACKUP_SCRIPT}${RESET}\n"
    # Filter out 'run' if passed as positional argument to script
    local script_args=()
    for a in "$@"; do
        if [[ "$a" != "run" && "$a" != "--run" ]]; then
            script_args+=("$a")
        fi
    done
    sudo bash "$BACKUP_SCRIPT" "${script_args[@]}"
}

# ==============================================================================
# SUBCOMMAND: update
# ==============================================================================
cmd_update() {
    banner
    echo -e "${CYAN}${BOLD}🔄 SYSTEM & CONTAINER UPDATE${RESET}\n"

    echo -e "${WHITE}1. Refreshing APT repositories and upgrading security packages...${RESET}"
    sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y

    if command -v docker >/dev/null 2>&1; then
        echo -e "\n${WHITE}2. Pruning dangling Docker images and build caches...${RESET}"
        docker image prune -f
    fi

    echo -e "\n${GREEN}${BOLD}✓ System updates completed successfully!${RESET}"
}

# ==============================================================================
# SUBCOMMAND: logs
# ==============================================================================
cmd_logs() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}Usage: janus logs <container_name_or_keyword>${RESET}"
        echo -e "Examples: janus logs coolify | janus logs docmost | janus logs postgres | janus logs janusdeck"
        exit 1
    fi

    local match
    match=$(docker ps --format '{{.Names}}' | grep -i "$target" | head -n1 || echo "")
    if [[ -z "$match" ]]; then
        echo -e "${RED}Error: No running container matching '${target}' found.${RESET}"
        echo -e "Active containers:"
        docker ps --format '  • {{.Names}} ({{.Image}})'
        exit 1
    fi

    echo -e "${CYAN}Tailing logs for: ${BOLD}${match}${RESET} (Press Ctrl+C to stop)...\n"
    docker logs -f --tail 100 "$match"
}

# ==============================================================================
# SUBCOMMAND: restart
# ==============================================================================
cmd_restart() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}Usage: janus restart <container_name_or_service>${RESET}"
        exit 1
    fi

    local match
    match=$(docker ps -a --format '{{.Names}}' | grep -i "$target" | head -n1 || echo "")
    if [[ -n "$match" ]]; then
        echo -e "${YELLOW}Restarting Docker container: ${match}...${RESET}"
        docker restart "$match"
        echo -e "${GREEN}✓ Container ${match} restarted.${RESET}"
    else
        echo -e "${YELLOW}No container found. Attempting systemd service restart: ${target}...${RESET}"
        sudo systemctl restart "$target"
        echo -e "${GREEN}✓ Service ${target} restarted.${RESET}"
    fi
}

# ==============================================================================
# SUBCOMMAND: version
# ==============================================================================
cmd_version() {
    echo "janus version ${JANUS_VERSION}"
}

# ==============================================================================
# SUBCOMMAND: help
# ==============================================================================
cmd_help() {
    banner
    echo -e "${WHITE}${BOLD}USAGE:${RESET}"
    echo -e "  ${GREEN}janus <command> [arguments]${RESET}\n"
    echo -e "${WHITE}${BOLD}AVAILABLE COMMANDS:${RESET}"
    echo -e "  ${BOLD}status${RESET}            Display complete live telemetry dashboard:"
    echo -e "                        • CPU, RAM & Disk Storage pools with visual usage bars"
    echo -e "                        • NVIDIA GPU VRAM, temps, power & compute apps"
    echo -e "                        • Running Docker homelab containers & WireGuard status"
    echo ""
    echo -e "  ${BOLD}to-windows${RESET}        1-click safe switch to Windows Gaming Rig"
    echo -e "                        (Auto-detects GRUB entry; returns to Linux automatically)"
    echo ""
    echo -e "  ${BOLD}backup${RESET}            Inspect automated backups or trigger manual snapshot:"
    echo -e "                        • Check if today's backup completed or is pending"
    echo -e "                        • List all local snapshots (dates, times, sizes)"
    echo -e "                        • Inspect 5TB Google Drive Rclone Crypt storage"
    echo -e "    ${DIM}status, list${RESET}       View snapshot inventory & today's status (default)"
    echo -e "    ${DIM}run [--force]${RESET}      Trigger immediate automated snapshot & cloud sync"
    echo ""
    echo -e "  ${BOLD}update${RESET}            Run APT upgrades, kernel security patches & prune docker"
    echo ""
    echo -e "  ${BOLD}logs <service>${RESET}    Follow live container logs (e.g. ${CYAN}janus logs docmost${RESET})"
    echo ""
    echo -e "  ${BOLD}restart <svc>${RESET}     Restart a container or systemd service"
    echo ""
    echo -e "  ${BOLD}version, -v${RESET}       Print current CLI version"
    echo ""
    echo -e "  ${BOLD}help, -h${RESET}          Show this help menu"
    echo ""
}

# ==============================================================================
# Main Router
# ==============================================================================
case "${1:-status}" in
    status)
        cmd_status
        ;;
    to-windows|windows|win)
        cmd_to_windows
        ;;
    backup)
        shift
        cmd_backup "$@"
        ;;
    update)
        cmd_update
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    restart)
        shift
        cmd_restart "$@"
        ;;
    version|--version|-v)
        cmd_version
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${RESET}\n"
        cmd_help
        exit 1
        ;;
esac
